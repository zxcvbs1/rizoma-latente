# Copiar a .env. Los valores privados se completan solo en esa copia local.
# Docker Compose exige una contraseña; se puede generar con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Para ejecutar Python en el host: completar la misma contraseña en DATABASE_URL.
# En Docker, la URL se construye con POSTGRES_PASSWORD y el host db.
DATABASE_URL=postgresql://rizoma:REEMPLAZAR@localhost:5432/rizoma
REDIS_URL=redis://localhost:6379/0
WAKU_URL=http://localhost:8645
OLLAMA_URL=http://localhost:11434
RIZOMA_API_URL=http://localhost:8000
MINIAPP_URL=http://localhost:5173

# Puentes opcionales; dejar vacíos cuando no se usan.
TELEGRAM_TOKEN=
DISCORD_TOKEN=

# Custodia delegada: no agregar comentarios al final de estos valores.
RIZOMA_KEYSTORE=user_keys.json
RIZOMA_AGENT_ID=mcp:default
# Vacío: se genera una identidad propia y se conserva en el keystore local.
GATEWAY_PRIVATE_KEY=

# Opciones del nodo.
RIZOMA_ACERVO_CONSENTIMIENTO=unanimidad
RIZOMA_N_CHICO_ACERVO=30
LECTOR_PISO_VECTORIAL=0.15
