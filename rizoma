#!/usr/bin/env python3
"""Emite una intención firmada usando la identidad local del cliente."""
import asyncio
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))

from dotenv import load_dotenv
from packages.adapters.waku_adapter import WakuAdapter
from packages.domain.identity import KeyStore, build_emit_event


async def main():
    if len(sys.argv) != 2:
        print("Uso: python rizoma '!ofrezco algo' o python rizoma '!busco algo'")
        return 2

    load_dotenv(Path(__file__).resolve().parent / ".env")
    _, private_key = KeyStore().get_or_create(os.getenv("RIZOMA_AGENT_ID", "mcp:default"))
    event = build_emit_event(private_key, sys.argv[1], tags=["cli-manual"])
    waku = WakuAdapter()
    waku.base_url = os.getenv("WAKU_URL", "http://localhost:8645")
    success = await waku.broadcast(event)
    print("Señal firmada y propagada." if success else "No se pudo conectar con Waku.")
    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))
